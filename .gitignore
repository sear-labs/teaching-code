# Rename to .gitignore and commit BEFORE anything else.
# Then verify, don't assume:  git check-ignore -v <each secret file>

# --- credentials: the one mistake that cannot be undone -----------------
.env
.env.*
*.lic
*.pem
*.key
*_key*
*_secret*
*credentials*
*token*
service-account*.json

# --- data: keep raw out unless it is small, public and immutable --------
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# --- generated results ---------------------------------------------------
# Deliberate exception (see standard Part 1 rule 5 and Part 5): final figures
# and tables ARE committed, so a reader sees outputs without running anything.
# Say so in the README. Un-ignore them here:
results/*
!results/figures/
!results/tables/
!results/**/.gitkeep

# --- python --------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- models and large artifacts ------------------------------------------
*.ckpt
*.pt
*.pth
*.h5
*.onnx

# --- solver / tool noise -------------------------------------------------
*.log
*.lp
*.mps
*.sol
*.ilp

# --- editor backups ------------------------------------------------------
*.bak
*.orig
*~

# NOT ignored on purpose: script_v2.py, module_old.py, report_FINAL.docx.
# Version control by filename is an anti-pattern (standard Part 8) but the fix
# is review, not .gitignore. A pattern like *_v[0-9]*.py silently drops real
# source in any project that has an api_v2.py -- a rule that hides source code
# is worse than the habit it was meant to discourage.

# --- os / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- this library specifically -------------------------------------------
# data/raw holds the instance TABLES the notebook and the package both read
# (standard Part 4, "tables versus knobs"). They are small, immutable and the
# agreement assertion depends on both sides seeing the same file, so they are
# committed deliberately. Un-ignore them:
!data/raw/
!data/raw/**

# Student work must never enter this repo. Nothing here should reference the
# Teaching Corpus, but guard the path anyway.
Teaching Corpus/
**/student*/

# --- the visibility boundary (standard Part 0) ---------------------------
# Notebooks are public and take outside pull requests. Consolidated
# observations on student work are education-record adjacent and staged
# private until a sharing protocol exists. One repo has ONE visibility, so if
# observations land in here the stricter rule wins and the notebooks lose every
# outside reader. Blocking DIRECTORIES named student* was not enough: a FILE
# named student_observations.md beside a notebook was committable.
**/student_*
**/*_students.*
**/cohort_*
**/*_observations.*
**/what_students_did.*
